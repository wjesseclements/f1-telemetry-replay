{
  "name": "f1-telemetry-replay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test -- --run --coverage && vite build && npm run check:layout",
    "format:check": "prettier --check \"{src,scripts}/**/*.{ts,tsx}\"",
    "validate:replay": "vite-node scripts/validate-replay.ts --",
    "check:layout": "vite-node scripts/layout-check.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
