# --- Node / Vite (app/) ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/

# --- Generated replay data (pipeline writes these; not committed) ---
# The tiny committed fixture lives at app/src/engine/__fixtures__/ and is NOT ignored.
app/public/data/
#
# app/public/gallery/ is DELIBERATELY NOT IGNORED, and the distinction is provenance
# rather than file type. app/public/data/ is scratch: whatever session the author last
# ran, regenerated constantly, meaningless to anyone else. app/public/gallery/ is three
# curated, provenance-stamped excerpts that ARE the product on a site with no backend —
# they have to deploy with the code, so they have to be committed. Kept honest by
# app/src/data/galleryAssets.test.ts, which fails if the set exceeds its 6 MB budget.
# See CLAUDE.md "Offline rule" and NOTICE.

# --- Python pipeline ---
pipeline/.venv/
__pycache__/
*.py[cod]
# pytest/coverage artefacts (the committed goldens live in pipeline/tests/golden/)
.pytest_cache/
.coverage
.coverage.*
coverage.xml

# --- FastF1 cache (can be hundreds of MB per session) ---
.f1cache/
**/.f1cache/

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code local-only settings (personal, never shared) ---
.claude/settings.local.json